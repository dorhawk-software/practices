# .practices/config: this project's settings for the scripts in
# .practices/bin (shell KEY=value lines). Every line is optional; the
# defaults are in .practices/bin/lib.sh. This file is the project's own:
# the practices sync never changes it.

# Git pathspecs left out of every check (vendored code).
#EXCLUDE=':!vendor'

# Lines of code per Rust file, and per integration test file.
#SIZE_CODE=700
#SIZE_TESTS=1000

# Folders where unsafe code may appear (space separated); empty: nowhere.
#UNSAFE_ALLOWED='crates/app-os'

# The git-ignored list of names never to commit, or "none".
#PRIVATE_TERMS=dev/private-terms

# Free space to keep on the disk the build folder is on.
#DISK_FLOOR_GB=300

# Files left out of the coverage share (regex on paths from the root).
#COVERAGE_EXCLUDE='^crates/app/src/(scenarios/|journey_)'

# The design boards check-ui renders (git pathspecs); empty: none.
#UI_BOARDS=':(glob)design/**/*.html'
# Window widths in px, and the colour schemes, each board is checked at.
#UI_WIDTHS='1100 1440'
#UI_THEMES='light dark'
# What counts as a click target (CSS selector), and the state classes
# whose removal must not move content.
#UI_TARGETS='button, a[href], [role=button], input, select, textarea, summary'
#UI_STATES='focus hover active pressed'
# Chrome or Chromium to render with; empty: found on its own.
#UI_CHROME=''

# The proposal and review pages check-page reads as the owner does, on a
# phone (git pathspecs; empty: none), and the widths in px it reads them at.
#UI_PAGES=':(glob)design/proposals/**/*.html :(glob)design/changes/**/*.html'
#PAGE_WIDTHS='375 390'

# The files that hold the copy people see, for check-voice (git pathspecs);
# the defaults cover common strings files, the changelog and a content/
# folder. Add the code files that hold copy too, and leave out quoted
# third-party text (licences):
#VOICE_FILES=':(glob)src/i18n/** :(glob)src/content/faq.ts'
# More "we" words to flag, as a regex alternation, for a language the
# check doesn't know (it knows English and Czech):
#VOICE_WORDS='wir|uns|unser(?:e|er|en|em)?'

# The files check-copy reads for each language's grammar (git pathspecs);
# empty: the design boards and the copy files above.
#COPY_FILES=''
# The language of copy that names none (a changelog, a content/ folder);
# empty: such copy is a finding, never a guess.
#COPY_LANG='en'
# The project's own copy-rules/<lang>.mjs files: a language the kit has
# no rules for (it has cs, en and es), or more rules for one it has.
#COPY_RULES='.practices/copy-rules'

# The code files check-permission-words reads besides the copy files
# (git pathspecs; the default reads Swift, Kotlin, Java, TS/JS and Dart,
# tests left out), and more grant verbs and permission nouns, as regex
# alternations, for a language it doesn't know (en, cs, es, vi):
#PERMISSION_FILES=':(glob)App/**/*.swift'
#PERMISSION_VERBS='erlauben|aktivieren'
#PERMISSION_NOUNS='Mitteilungen|Standort'

# The device families the iOS app ships for (1 iPhone, 2 iPad, "1,2"
# both), for check-xcode and check-ios-artefact; empty: the Xcode
# project's own project-level setting.
#DEVICE_FAMILY='1'
# More frameworks that need an entitlement, as Framework=entitlement pairs.
#ENTITLED_FRAMEWORKS='WeatherKit=com.apple.developer.weatherkit'

# The launch arguments that pin the app's language in UI tests (a regex,
# for check-ui-tests); add the app's own switch.
#UITEST_LANGUAGE='-AppleLanguages|-AppleLocale|-AcmeLanguage'
# The launch argument a UI test starts the app offline with (an extended
# regex, for check-ui-tests); the default is any argument ending in Offline.
#UITEST_OFFLINE='-AcmeNoNetwork'
# How the app's code reads a launch switch for a screen state (an extended
# regex whose first quoted string is the switch); each one is passed by an
# audited UI test. The default: arguments.contains("-AcmeTour").
#UITEST_STATES='arguments\.contains\("-[A-Za-z][A-Za-z0-9]*"\)|launchFlag\("-[A-Za-z]+"\)'
# The ratchet for states from before that rule, one per line.
#UITEST_STATES_BASELINE='.practices/unaudited-states'

# The Swift files check-motion reads (git pathspecs; tests left out), and
# the app's own names for a selection state, added to selected…,
# selection…, highlighted…, …Selection and …Selected (a regex alternation):
#MOTION_FILES=':(glob)App/**/*.swift'
#MOTION_SELECTION='picked\w*|chosen\w*'
