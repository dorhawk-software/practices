cat >"$p/App/Views.swift" <<'SWIFT'
struct Views: View {
    var body: some View {
        VStack(spacing: 0) {
            Button("Close all") { close() }
                .buttonStyle(.flapCell(.top))
            Rectangle().frame(height: 1)
            Button("Until a date…") { until() }
                .buttonStyle(.flapCell(.bottom))
        }
        HStack {
            Button("Back") { back() }
                .buttonStyle(.bordered)
            Button("Skip") { skip() }
                .buttonStyle(.bordered)
        }
        Button("Next") { next() }
            .buttonStyle(.flap)
        Button("Not now") { later() }
            .buttonStyle(.plain)
        Picker("Hour", selection: $hour) {
            ForEach(0..<24) { Text("\($0)").tag($0) }
        }
        .pickerStyle(.wheel)
        Menu("Sort") {
            Button("Name") { sort(.name) }
            Button("Date") { sort(.date) }
        }
        // practices-allow menu: the flock's members, six at most
        Menu("Cheer") { ForEach(members) { m in Button(m.name) { cheer(m) } } }
        DatePicker("Time", selection: $end, displayedComponents: .hourAndMinute)
            .datePickerStyle(.wheel)
    }
}
SWIFT
expect 0 "check-views passes one line, ViewThatFits, fixedSize, tied dots, a sum on one line, comments, other strings, a marked dot, a comment: argument, one block of two buttons, a pair side by side, two styles, a wheel, a short menu and a marked one" "$p/.practices/bin/check-views"
