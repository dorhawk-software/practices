# --- check-motion: a selection switches at once (ui/visual-craft.md);
# a deliberate slide is marked with its reason
ev() { printf '{"hook_event_name":"%s","tool_name":"%s","tool_input":{"command":"%s"},"stop_hook_active":%s}' "$1" "$2" "${3:-}" "${4:-false}"; }
p=$(project)
expect 0 "check-motion with no Swift passes, saying so" "$p/.practices/bin/check-motion"
mkdir -p "$p/App"
cat >"$p/App/Chart.swift" <<'SWIFT'
struct Chart: View {
    @State private var selected: Date?
    var body: some View {
        Bars(selected: selected)
            .onTapGesture { day in
                // withAnimation { selected = day } would cross-fade the bars
                selected = selected == day ? nil : day
                withAnimation(.spring) { grown = true }
                withAnimation { if selected == nil { shown.toggle() } }
            }
            .animation(.easeOut, value: grown)
        Text("withAnimation { selected = day }")
        // practices-allow motion: the capsule slides between tabs
        Tabs().onChange(of: tab) { withAnimation { tabSelection = tab } }
    }
}
SWIFT
expect 0 "check-motion passes a selection set at once, other animations, comments, strings and a marked slide" "$p/.practices/bin/check-motion"
cat >"$p/App/Trend.swift" <<'SWIFT'
struct Trend: View {
    @State private var selected: Date?
    @State private var highlighted = false
    var body: some View {
        Bars().onTapGesture { day in
            withAnimation(.snappy) { selected = selected == day ? nil : day }
        }
        .animation(.snappy, value: highlightedRow)
        Button("Pick") {
            withAnimation(.bouncy) {
                self.highlighted.toggle()
            }
        }
        Row().onTapGesture { withAnimation { currentSelection = 2 } } // practices-allow motion: slides
        Row().onTapGesture { withAnimation { pickedDay = 2 } }
    }
}
SWIFT
out=$("$p/.practices/bin/check-motion" 2>&1)
st=$?
[ $st = 1 ] && ok || bad "check-motion fails on an animated selection (exit $st)" "$out"
for want in 'Trend.swift:6 withAnimation sets the selection "selected"' 'Trend.swift:8 .animation follows the selection "highlightedRow"' \
    'Trend.swift:10 withAnimation sets the selection "highlighted"' 'Trend.swift:14 marks an exception without its reason' 'Rule: A selection switches at once'; do
    case $out in *"$want"*) ok ;; *) bad "check-motion finds $want" "$out" ;; esac
done
case $out in *Chart.swift* | *pickedDay*) bad "check-motion leaves alone what sets no selection, and names it doesn't know" "$out" ;; *) ok ;; esac
echo "MOTION_SELECTION='picked\w*'" >>"$p/.practices/config"
out=$("$p/.practices/bin/check-motion" "$p/App/Trend.swift" 2>&1)
case $out in *'Trend.swift:15 withAnimation sets the selection "pickedDay"'*) ok ;; *) bad "MOTION_SELECTION adds the app's own names" "$out" ;; esac
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
# The gate runs where the others do: after an edit, before a commit, in lint.
"$p/.practices/bin/install-hooks" >/dev/null
rm "$p/App/Trend.swift"
git -C "$p" add App/Chart.swift && git -C "$p" commit -qm "Chart" >/dev/null 2>&1 && ok || bad "pre-commit lets a selection set at once through"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes a selection set at once"
printf 'struct T: View {\n    @State var selected = 0\n    var body: some View { Text("a").onTapGesture { withAnimation { selected = 1 } } }\n}\n' >"$p/App/Chart.swift"
out=$(ev PostToolUse Edit | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'[motion]'*'Chart.swift:3'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands an animated selection back to the agent" "$out"
out=$("$p/.practices/bin/lint" 2>&1)
st=$?
[ $st != 0 ] && case $out in *"selections failed"*) true ;; *) false ;; esac && ok || bad "lint fails while a selection is animated" "$out"
git -C "$p" add App/Chart.swift
git -C "$p" commit -qm "Chart" >/dev/null 2>&1 && bad "pre-commit refuses an animated selection" || ok

# --- check-views: a joined line breaks between its parts (ui/visual-craft.md);
# a quoted dot is marked with its reason
p=$(project)
