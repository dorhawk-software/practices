# --- check-ios-artefact: the built archive's bundles, their device family and
# the entitlements their linked frameworks need. otool and codesign are
# stand-ins here that read what the test wrote beside each binary.
apple=$work/apple
mkdir -p "$apple"
# shellcheck disable=SC2016 # the stand-ins' own variables
printf '#!/bin/sh\n[ "$1" = -L ] || exit 1\necho "$2:"\ncat "$2.links" 2>/dev/null\n' >"$apple/otool"
# shellcheck disable=SC2016
printf '#!/bin/sh\nfor a; do b=$a; done\n[ -f "$b/entitlements.xml" ] || { echo "$b: code object is not signed at all" >&2; exit 1; }\ncat "$b/entitlements.xml"\n' >"$apple/codesign"
chmod +x "$apple/otool" "$apple/codesign"
artefact() { OTOOL=$apple/otool CODESIGN=$apple/codesign "$@"; }
bundle() { # bundle DIR EXECUTABLE FAMILIES ENTITLED FRAMEWORK...: an app or extension the stand-ins read
    local dir=$1 exe=$2 fams=$3 ent=$4 f
    shift 4
    mkdir -p "$dir"
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0">\n<dict>\n<key>CFBundleExecutable</key><string>%s</string>\n<key>UIDeviceFamily</key><array>' "$exe"
        for f in $fams; do printf '<integer>%s</integer>' "$f"; done
        printf '</array>\n</dict>\n</plist>\n'
    } >"$dir/Info.plist"
    : >"$dir/$exe"
    : >"$dir/$exe.links"
    for f in "$@"; do printf '\t%s (compatibility version 1.0.0, current version 1.0.0)\n' "$f" >>"$dir/$exe.links"; done
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0">\n<dict>\n'
        [ "$ent" = yes ] && printf '<key>com.apple.developer.family-controls</key><true/>\n'
        printf '</dict>\n</plist>\n'
    } >"$dir/entitlements.xml"
}
p=$(project)
arc=$p/build/Acme.xcarchive
app=$arc/Products/Applications/Acme.app
bundle "$app" Acme "1" yes /System/Library/Frameworks/FamilyControls.framework/FamilyControls @rpath/Engine.framework/Engine
bundle "$app/PlugIns/Widget.appex" Widget "1" yes /System/Library/Frameworks/ManagedSettings.framework/ManagedSettings
mkdir -p "$app/Frameworks/Engine.framework"
: >"$app/Frameworks/Engine.framework/Engine"
printf '\t/System/Library/Frameworks/DeviceActivity.framework/DeviceActivity (compatibility version 1.0.0)\n' >"$app/Frameworks/Engine.framework/Engine.links"
expect 0 "check-ios-artefact passes an archive whose binaries carry their entitlements" artefact "$p/.practices/bin/check-ios-artefact" "$arc"
bundle "$app/PlugIns/Widget.appex" Widget "1" no /System/Library/Frameworks/ManagedSettings.framework/ManagedSettings
out=$(artefact "$p/.practices/bin/check-ios-artefact" "$arc" 2>&1)
[ $? = 1 ] && case $out in *'Widget.appex: links ManagedSettings, and its signature lacks com.apple.developer.family-controls'*) true ;; *) false ;; esac && ok ||
    bad "check-ios-artefact finds a widget that links ManagedSettings without Family Controls" "$out"
bundle "$app/PlugIns/Widget.appex" Widget "1" no @rpath/Engine.framework/Engine
out=$(artefact "$p/.practices/bin/check-ios-artefact" "$arc" 2>&1)
case $out in *'Widget.appex: links DeviceActivity'*) ok ;; *) bad "check-ios-artefact follows an embedded framework to what it links" "$out" ;; esac
bundle "$app/PlugIns/Widget.appex" Widget "1 2" yes /System/Library/Frameworks/ManagedSettings.framework/ManagedSettings
out=$(artefact "$p/.practices/bin/check-ios-artefact" "$arc" 2>&1)
[ $? = 1 ] && case $out in *'Widget.appex: UIDeviceFamily is 1,2 (iPhone, iPad), and the app is for 1 (iPhone)'*) true ;; *) false ;; esac && ok ||
    bad "check-ios-artefact finds an extension built for iPad too" "$out"
bundle "$app" Acme "1 2" yes /System/Library/Frameworks/FamilyControls.framework/FamilyControls
echo "DEVICE_FAMILY=1" >>"$p/.practices/config"
out=$(artefact "$p/.practices/bin/check-ios-artefact" "$arc" 2>&1)
case $out in *'Acme.app: UIDeviceFamily is 1,2 (iPhone, iPad), and the app is for 1 (iPhone)'*) ok ;; *) bad "check-ios-artefact holds the app to DEVICE_FAMILY" "$out" ;; esac
python3 -c 'import os, sys, zipfile
with zipfile.ZipFile(sys.argv[2], "w") as z:
    for d, _, names in os.walk(sys.argv[1]):
        for n in names:
            f = os.path.join(d, n); z.write(f, "Payload/" + os.path.relpath(f, os.path.dirname(sys.argv[1])))' "$app" "$p/build/Acme.ipa"
out=$(cd "$p/build" && artefact "$p/.practices/bin/check-ios-artefact" Acme.ipa 2>&1)
case $out in *'Acme.app: UIDeviceFamily is 1,2'*) ok ;; *) bad "check-ios-artefact reads an .ipa, by a path relative to the caller" "$out" ;; esac
out=$(OTOOL=$work/no-otool "$p/.practices/bin/check-ios-artefact" "$arc" 2>&1)
[ $? = 2 ] && case $out in *"can't say the app is clean"*'no-otool'*) true ;; *) false ;; esac && ok ||
    bad "check-ios-artefact fails without otool, never passes" "$out"
rm "$app/PlugIns/Widget.appex/entitlements.xml"
out=$(artefact "$p/.practices/bin/check-ios-artefact" "$arc" 2>&1)
[ $? = 2 ] && ok || bad "check-ios-artefact fails on a bundle it can't read the signature of" "$out"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
bundle "$app" Acme "1" yes /System/Library/Frameworks/FamilyControls.framework/FamilyControls
bundle "$app/PlugIns/Widget.appex" Widget "1" no /System/Library/Frameworks/ManagedSettings.framework/ManagedSettings
# claude-hook reads the archive after the agent's xcodebuild archive or -exportArchive.
xev() { printf '{"hook_event_name":"PostToolUse","tool_name":"Bash","tool_input":{"command":"%s"},"cwd":"%s"}' "$1" "$p"; }
out=$(xev "xcodebuild archive -scheme Acme -archivePath build/Acme" | artefact "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'check-ios-artefact failed on'*'Acme.xcarchive'*'Widget.appex: links ManagedSettings'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook checks the archive after xcodebuild archive" "$out"
rm "$p/build/Acme.ipa"
mkdir -p "$p/build/export"
python3 -c 'import os, sys, zipfile
with zipfile.ZipFile(sys.argv[2], "w") as z:
    for d, _, names in os.walk(sys.argv[1]):
        for n in names:
            f = os.path.join(d, n); z.write(f, "Payload/" + os.path.relpath(f, os.path.dirname(sys.argv[1])))' "$app" "$p/build/export/Acme.ipa"
out=$(xev "nice -n 19 xcodebuild -exportArchive -archivePath build/Acme.xcarchive -exportPath 'build/export' -exportOptionsPlist x.plist" | artefact "$p/.practices/bin/claude-hook" 2>&1)
[ $? = 2 ] && case $out in *'Acme.ipa'*) true ;; *) false ;; esac && ok || bad "claude-hook checks the .ipa after xcodebuild -exportArchive" "$out"
xev "xcodebuild build -scheme Acme" | artefact "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "claude-hook leaves the archive alone after a plain build"
# Before an upload (PreToolUse): the build is checked first; a failing or
# missing one isn't sent. Until 1.13.0 the check came after the upload.
pre() { printf '{"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"%s"},"cwd":"%s"}' "$1" "$p"; }
printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>destination</key><string>upload</string></dict></plist>\n' >"$p/upload.plist"
printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>destination</key><string>export</string></dict></plist>\n' >"$p/export.plist"
out=$(pre "xcodebuild -exportArchive -archivePath build/Acme.xcarchive -exportPath build/export -exportOptionsPlist upload.plist" | artefact "$p/.practices/bin/claude-hook" 2>&1)
[ $? = 2 ] && case $out in *'Upload refused: check-ios-artefact failed on'*'Acme.xcarchive'*'Widget.appex: links ManagedSettings'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook refuses an -exportArchive that uploads a failing archive" "$out"
pre "xcodebuild -exportArchive -archivePath build/Acme.xcarchive -exportPath build/export -exportOptionsPlist export.plist" | artefact "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "claude-hook leaves an export to a folder for after it (PostToolUse)"
out=$(pre "xcrun altool --upload-app -f build/export/Acme.ipa -t ios" | artefact "$p/.practices/bin/claude-hook" 2>&1)
[ $? = 2 ] && case $out in *'Upload refused'*'Acme.ipa'*) true ;; *) false ;; esac && ok || bad "claude-hook refuses altool --upload-app with a failing .ipa" "$out"
out=$(pre "xcrun iTMSTransporter -m upload -assetFile build/export/Acme.ipa" | artefact "$p/.practices/bin/claude-hook" 2>&1)
[ $? = 2 ] && case $out in *'Upload refused'*'Acme.ipa'*) true ;; *) false ;; esac && ok || bad "claude-hook refuses iTMSTransporter -m upload with a failing .ipa" "$out"
out=$(pre "xcrun altool --upload-package build/gone.ipa --apple-id 1" | artefact "$p/.practices/bin/claude-hook" 2>&1)
[ $? = 2 ] && case $out in *'needs to read that build first'*'gone.ipa'*) true ;; *) false ;; esac && ok || bad "claude-hook refuses an upload of a build that isn't there" "$out"
out=$(pre "xcodebuild -exportArchive -exportPath build/export -exportOptionsPlist upload.plist" | artefact "$p/.practices/bin/claude-hook" 2>&1)
[ $? = 2 ] && case $out in *'none named'*) true ;; *) false ;; esac && ok || bad "claude-hook refuses an upload that names no archive" "$out"
for c in "xcrun altool --validate-app -f build/export/Acme.ipa" "ls build" "xcodebuild archive -scheme Acme -archivePath build/Acme"; do
    pre "$c" | artefact "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook lets a command that uploads nothing run: $c"
done
bundle "$app/PlugIns/Widget.appex" Widget "1" yes /System/Library/Frameworks/ManagedSettings.framework/ManagedSettings
pre "xcodebuild -exportArchive -archivePath build/Acme.xcarchive -exportPath build/export -exportOptionsPlist upload.plist" | artefact "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "claude-hook lets a clean archive be uploaded"

# --- check-ui-tests: XCUITests pin the language, run the accessibility audit,
# and run on an iPhone SE at a large text size (mobile/app-review.md)
p=$(project)
expect 0 "check-ui-tests with no UI tests passes, saying so" "$p/.practices/bin/check-ui-tests"
mkdir -p "$p/UITests" "$p/scripts"
uitest() { # uitest ARGUMENTS AUDIT: a UI test file
    printf 'import XCTest\n\nfinal class FlowTests: XCTestCase {\n    func testOnboarding() throws {\n        let app = XCUIApplication()\n        app.launchArguments = [%s]\n        app.launch()\n        add(XCTAttachment(screenshot: app.screenshot()))\n        %s\n        XCTAssertTrue(app.buttons["Continue"].isHittable)\n    }\n}\n' "$1" "$2" >"$p/UITests/FlowTests.swift"
}
printf 'import XCTest\n\nfinal class OfflineTests: XCTestCase {\n    func testTodayOffline() throws {\n        let app = XCUIApplication()\n        app.launchArguments = ["-AppleLanguages", "(en)", "-AcmeLanguage", "en", "-AcmeOffline"]\n        app.launch()\n        XCTAssertTrue(app.staticTexts["Today"].waitForExistence(timeout: 3))\n    }\n}\n' >"$p/UITests/OfflineTests.swift"
uitest '"-AppleLanguages", "(en)", "-AppleLocale", "en_US"' 'try app.performAccessibilityAudit()'
# shellcheck disable=SC2016 # the script's own variable
printf '#!/bin/sh\nxcrun simctl ui "$SIM" content_size extra-extra-large\nxcodebuild test -scheme Acme -destination "platform=iOS Simulator,name=iPhone SE (3rd generation)"\n' >"$p/scripts/ui-tests.sh"
expect 0 "check-ui-tests passes tests in a pinned language, audited, offline, on an iPhone SE at a large size" "$p/.practices/bin/check-ui-tests"
mv "$p/UITests/OfflineTests.swift" "$work/OfflineTests.swift"
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'no UI test launches the app offline'*'mobile/lifecycle.md'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests finds no UI test that launches the app offline" "$out"
uitest '"-AppleLanguages", "(en)", "-AcmeNoNetwork"' 'try app.performAccessibilityAudit()'
echo "UITEST_OFFLINE='-AcmeNoNetwork'" >>"$p/.practices/config"
expect 0 "UITEST_OFFLINE names the app's own offline switch" "$p/.practices/bin/check-ui-tests"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
mv "$work/OfflineTests.swift" "$p/UITests/OfflineTests.swift"
uitest '"-AcmeDemo"' 'try app.performAccessibilityAudit()'
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'launch the app without pinning its language'*'UITests/FlowTests.swift'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests finds a test that launches the app in the simulator's language" "$out"
uitest '"-AcmeLanguage", "en"' 'try app.performAccessibilityAudit()'
echo "UITEST_LANGUAGE='-AcmeLanguage'" >>"$p/.practices/config"
expect 0 "UITEST_LANGUAGE names the app's own language switch" "$p/.practices/bin/check-ui-tests"
uitest '"-AcmeLanguage", "en"' ''
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
case $out in *"no UI test runs Xcode's accessibility audit"*) ok ;; *) bad "check-ui-tests finds UI tests without the accessibility audit" "$out" ;; esac
rm "$p/scripts/ui-tests.sh"
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
case $out in *'no test run names an iPhone SE simulator'*'no test run sets a large text size'*) ok ;; *) bad "check-ui-tests finds no iPhone SE run and no large text size" "$out" ;; esac
uitest '"-AcmeLanguage", "en", "-UIPreferredContentSizeCategoryName", "UICTContentSizeCategoryXXL"' 'try app.performAccessibilityAudit() // on an iPhone SE (3rd generation)'
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
case $out in *'no test run names an iPhone SE'*) ok ;; *) bad "check-ui-tests doesn't take a Swift comment for an iPhone SE run" "$out" ;; esac
printf 'xcodebuild test -scheme Acme -destination "platform=iOS Simulator,name=iPhone SE (3rd generation)"\n' >"$p/scripts/ui-tests.sh"
expect 0 "check-ui-tests reads the large size from the launch arguments" "$p/.practices/bin/check-ui-tests"
# An audit exception names its element; each audited screen keeps its picture.
# shellcheck disable=SC2016 # the script's own variable
printf 'xcrun simctl ui "$SIM" content_size extra-extra-large\n' >>"$p/scripts/ui-tests.sh"
uitest '"-AcmeLanguage", "en"' 'try app.performAccessibilityAudit { issue in if issue.auditType == .textClipped { return true }; return false }'
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'turns a whole check off'*'FlowTests.swift:'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests finds an audit exception on the type alone" "$out"
uitest '"-AcmeLanguage", "en"' 'try app.performAccessibilityAudit { issue in switch issue.auditType { case .contrast: return true; default: return false } }'
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'turns a whole check off'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests finds a case that returns true on the type alone" "$out"
uitest '"-AcmeLanguage", "en"' 'try app.performAccessibilityAudit { issue in if issue.auditType == .textClipped, issue.element?.identifier == "appName" { return true }; return false }'
expect 0 "check-ui-tests passes an exception that names its element" "$p/.practices/bin/check-ui-tests"
sed -i.bak '/XCTAttachment(screenshot:/d' "$p/UITests/FlowTests.swift" && rm "$p/UITests/FlowTests.swift.bak"
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'without keeping a picture'*'UITests/FlowTests.swift'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests finds an audit that keeps no picture of the screen" "$out"
# Every screen state the app can be launched in is audited, or says why not.
uitest '"-AcmeLanguage", "en"' 'try app.performAccessibilityAudit()'
mkdir -p "$p/App"
printf 'enum Demo {\n    static let arguments = ProcessInfo.processInfo.arguments\n    static var tour: Bool { arguments.contains("-AcmeTour") }\n}\n' >"$p/App/Demo.swift"
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'never audited'*'-AcmeTour (App/Demo.swift:3)'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests finds a screen state no audited test launches" "$out"
uitest '"-AcmeLanguage", "en", "-AcmeTour"' 'try app.performAccessibilityAudit()'
expect 0 "check-ui-tests passes a state an audited test launches" "$p/.practices/bin/check-ui-tests"
uitest '"-AcmeLanguage", "en"' 'try app.performAccessibilityAudit()'
printf 'enum Demo {\n    static let arguments = ProcessInfo.processInfo.arguments\n    // practices-allow audit: renders the store pictures, not a screen\n    static var tour: Bool { arguments.contains("-AcmeTour") }\n}\n' >"$p/App/Demo.swift"
expect 0 "check-ui-tests passes a state marked practices-allow audit" "$p/.practices/bin/check-ui-tests"
printf 'enum Demo {\n    static let arguments = ProcessInfo.processInfo.arguments\n    static var tour: Bool { arguments.contains("-AcmeTour") }\n}\n' >"$p/App/Demo.swift"
printf -- '-AcmeTour  # from before the rule\n' >"$p/.practices/unaudited-states"
expect 0 "check-ui-tests passes a state listed in the baseline" "$p/.practices/bin/check-ui-tests"
uitest '"-AcmeLanguage", "en", "-AcmeTour"' 'try app.performAccessibilityAudit()'
out=$("$p/.practices/bin/check-ui-tests" 2>&1)
[ $? = 1 ] && case $out in *'no longer need it'*'-AcmeTour (audited now)'*) true ;; *) false ;; esac && ok ||
    bad "check-ui-tests asks for the baseline to be lowered once a state is audited" "$out"
rm "$p/.practices/unaudited-states" "$p/App/Demo.swift"
uitest '"-AcmeDemo"' 'try app.performAccessibilityAudit()'
out=$("$p/.practices/bin/lint" 2>&1)
st=$?
[ $st != 0 ] && case $out in *"UI tests failed"*) true ;; *) false ;; esac && ok || bad "lint fails while a UI test doesn't pin the language" "$out"

# --- bin/install gives a native iOS project the mobile rules
p=$(project)
printf 'name: Acme\n' >"$p/project.yml"
"$here/bin/install" "$p" >/dev/null
grep -q 'mobile/app-review.md' "$p/.practices/rules.md" && grep -q 'mobile/lifecycle.md' "$p/.practices/rules.md" && ok ||
    bad "rules.md has the mobile rules in a project with an XcodeGen spec"

# --- claude-hook: the UI gate after any edit to a board, and before the turn ends
ev() { printf '{"hook_event_name":"%s","tool_name":"%s","tool_input":{"command":"%s"},"stop_hook_active":%s}' "$1" "$2" "${3:-}" "${4:-false}"; }
p=$(project)
mkdir -p "$p/design"
cp "$here/tests/ui/clean.html" "$p/design/board.html"
ev PostToolUse Write | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes a clean board"
cp "$here/tests/ui/contain.html" "$p/design/board.html" # a shell edit, no Edit tool
out=$(ev PostToolUse Bash "cp a b" | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'[contain]'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands a board's findings back (exit 2) after a shell edit" "$out"
ev PostToolUse Read | "$p/.practices/bin/claude-hook" >/dev/null 2>&1
st=$?
[ $st = 2 ] && ok || bad "claude-hook keeps reporting a failing board until it is fixed"
out=$(ev Stop "" "" false | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'You may not stop yet'*) true ;; *) false ;; esac && ok ||
    bad "the Stop hook blocks the turn's end while a board fails" "$out"
out=$(ev Stop "" "" true | "$p/.practices/bin/claude-hook" 2>/dev/null)
st=$?
[ $st = 0 ] && case $out in *systemMessage*'still open in design/board.html'*) true ;; *) false ;; esac && ok ||
    bad "blocked twice on the same findings, the agent may stop and the person is told" "$out"
cp "$here/tests/ui/clean.html" "$p/design/other.html"
printf 'PRIVATE_TERMS=none\nUI_BOARDS=design/other.html\n' >"$p/.practices/config"
ev PostToolUse Read | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "claude-hook stops checking a failing board once the gate no longer reads it"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
cp "$here/tests/ui/clean.html" "$p/design/board.html"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ev Stop "" "" false | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "once the board is fixed, edits and the turn's end pass"
# A proposal page, read by check-page (UI_PAGES), not only by check-ui.
mkdir -p "$p/design/changes"
printf 'PRIVATE_TERMS=none\nUI_BOARDS=design/board.html\n' >"$p/.practices/config"
cp "$here/tests/page/one-letter-end.html" "$p/design/changes/page.html"
out=$(ev PostToolUse Write | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'check-page failed'*'[one-letter-end]'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands a proposal page's findings back (exit 2)" "$out"
cp "$here/tests/page/clean.html" "$p/design/changes/page.html"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes the page once it is fixed"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"

# The voice gate: after an edit, before the turn ends, before a commit, in lint.
p=$(project)
"$p/.practices/bin/install-hooks" >/dev/null
mkdir -p "$p/src/i18n"
printf "const en = {\n  'a': 'Saved.',\n};\n" >"$p/src/i18n/strings.ts"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes copy without we"
printf "const en = {\n  'a': 'We saved it.',\n};\n" >"$p/src/i18n/strings.ts"
out=$(ev PostToolUse Edit | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'[voice]'*'"We"'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands we in the copy back to the agent" "$out"
out=$(ev Stop "" "" false | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'You may not stop yet'*'[voice]'*) true ;; *) false ;; esac && ok ||
    bad "the Stop hook blocks while the copy says we" "$out"
out=$("$p/.practices/bin/lint" 2>&1)
st=$?
[ $st != 0 ] && case $out in *"the product's voice failed"*'"We"'*) true ;; *) false ;; esac && ok ||
    bad "lint fails while the copy says we" "$out"
git -C "$p" add src/i18n/strings.ts
git -C "$p" commit -qm "Copy" >/dev/null 2>&1 && bad "pre-commit refuses copy that says we" || ok
printf "const en = {\n  'a': 'Saved.',\n};\n" >"$p/src/i18n/strings.ts"
git -C "$p" add src/i18n/strings.ts
git -C "$p" commit -qm "Copy" >/dev/null 2>&1 && ok || bad "pre-commit lets copy without we through"

# --- pre-commit: a failing board can't be committed; nor can unwired hooks
p=$(project)
"$p/.practices/bin/install-hooks" >/dev/null
mkdir -p "$p/design"
cp "$here/tests/ui/contain.html" "$p/design/board.html"
git -C "$p" add design/board.html
git -C "$p" commit -qm "Add a board" >/dev/null 2>&1 && bad "pre-commit refuses a board that fails check-ui" || ok
cp "$here/tests/ui/clean.html" "$p/design/board.html"
git -C "$p" add design/board.html
git -C "$p" commit -qm "Add a board" >/dev/null 2>&1 && ok || bad "pre-commit lets a clean board through"
mkdir -p "$p/design/changes"
printf 'PRIVATE_TERMS=none\nUI_BOARDS=design/board.html\n' >"$p/.practices/config"
cp "$here/tests/page/sideways.html" "$p/design/changes/page.html"
git -C "$p" add design/changes/page.html
git -C "$p" commit -qm "Add a proposal page" >/dev/null 2>&1 && bad "pre-commit refuses a proposal page that fails check-page" || ok
cp "$here/tests/page/clean.html" "$p/design/changes/page.html"
git -C "$p" add design/changes/page.html
git -C "$p" commit -qm "Add a proposal page" >/dev/null 2>&1 && ok || bad "pre-commit lets a clean proposal page through"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
mkdir -p "$p/.claude"
cp "$here/templates/claude-settings.json" "$p/.claude/settings.json"
expect 0 "check-hooks passes the template" "$p/.practices/bin/check-hooks"
printf '{"hooks":{"PostToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"x/.practices/bin/claude-hook"}]}]}}\n' >"$p/.claude/settings.json"
out=$("$p/.practices/bin/check-hooks" 2>&1)
st=$?
[ $st = 1 ] && case $out in *'after Edit'*'PreToolUse'*'Stop'*) true ;; *) false ;; esac && ok ||
    bad "check-hooks finds edits, the pre-upload check and Stop unwired" "$out"
git -C "$p" add .claude/settings.json
git -C "$p" commit -qm "Settings" >/dev/null 2>&1 && bad "pre-commit refuses settings that drop the hooks" || ok
# shellcheck disable=SC2016 # $CLAUDE_PROJECT_DIR is for Claude Code to expand
printf '{"hooks":{"PostToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"\\"$CLAUDE_PROJECT_DIR\\"/.practices/bin/claude-hook","timeout":900}]}]}}\n' >"$p/.claude/settings.json"
cp "$p/.claude/settings.json" "$work/old-settings"
"$here/bin/install" "$p" >/dev/null
cmp -s "$p/.claude/settings.json" "$here/templates/claude-settings.json" && bad "install leaves settings the project changed alone" || ok

echo "$passed passed, $failed failed ($(($(date +%s) - started)) s)"
[ $failed = 0 ]
