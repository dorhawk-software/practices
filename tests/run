#!/usr/bin/env bash
# Tests of the kit's checks, each against a throwaway project: a checker
# with a hole lets through exactly what it exists to stop (Crake's size
# check missed a 736-line file; its privacy check passed everything on
# macOS). Where macOS' bash 3.2 is at /bin/bash, the scripts run under it.
#
#   tests/run
# shellcheck disable=SC2015 # ok() never fails
set -uo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

shim=$work/shim
mkdir -p "$shim"
if /bin/bash -c '[ "${BASH_VERSINFO[0]}" -lt 4 ]' 2>/dev/null; then
    ln -s /bin/bash "$shim/bash"
    echo "(scripts run under $(/bin/bash -c 'echo $BASH_VERSION'))"
fi
export PATH="$shim:$PATH"
unset CI PRACTICES_PRIVATE_TERMS PRACTICES_BASE_REF

passed=0 failed=0
ok() { passed=$((passed + 1)); }
bad() { failed=$((failed + 1)); printf 'FAIL: %s\n%s\n' "$1" "${2:-}"; }
# expect 0|1 NAME COMMAND...: the exit status is 0, or anything else.
expect() {
    local want=$1 name=$2 out status
    shift 2
    out=$("$@" 2>&1)
    status=$?
    if { [ "$want" = 0 ] && [ $status = 0 ]; } || { [ "$want" = 1 ] && [ $status != 0 ]; }; then
        ok
    else
        bad "$name (exit $status, wanted $( [ "$want" = 0 ] && echo 0 || echo non-zero))" "$out"
    fi
}

project() { # a fresh git project with the kit in it
    p=$work/p$RANDOM$RANDOM
    mkdir -p "$p/crates/app/src"
    git -C "$p" init -q
    git -C "$p" config user.email t@example.com
    git -C "$p" config user.name t
    "$here/bin/install" "$p" >/dev/null
    printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
    echo "$p"
}
lines() { local i; for ((i = 0; i < $1; i++)); do echo "// $i"; done; }

# --- check-size
p=$(project)
lines 700 >"$p/crates/app/src/ok.rs"
expect 0 "700 lines pass" "$p/.practices/bin/check-size"
lines 701 >"$p/crates/app/src/big.rs"
expect 1 "701 lines fail" "$p/.practices/bin/check-size"
{ lines 600; printf '#[cfg(test)]\nmod tests {\n'; lines 300; echo '}'; } >"$p/crates/app/src/big.rs"
expect 0 "an inline test module isn't counted" "$p/.practices/bin/check-size"
{ printf '#[cfg(test)]\nmod tests;\n'; lines 720; } >"$p/crates/app/src/big.rs"
expect 1 "cfg(test) over \`mod tests;\` exempts nothing (Crake 6de1e6a)" "$p/.practices/bin/check-size"
{ lines 600; printf '#[cfg(all(test, target_os = "linux"))]\nmod linux_tests {\n'; lines 300; echo '}'; } >"$p/crates/app/src/big.rs"
expect 0 "cfg(all(test, ...)) starts the test module" "$p/.practices/bin/check-size"
lines 1000 >"$p/crates/app/src/big.rs"
printf 'crates/app/src/big.rs 1000\n' >"$p/.practices/size-allowlist"
expect 0 "an allowlisted file at its number passes" "$p/.practices/bin/check-size"
lines 1001 >"$p/crates/app/src/big.rs"
expect 1 "an allowlisted file may not grow" "$p/.practices/bin/check-size"
lines 990 >"$p/crates/app/src/big.rs"
expect 1 "a file that shrank must lower its number" "$p/.practices/bin/check-size"
lines 100 >"$p/crates/app/src/big.rs"
expect 1 "a file under the limit leaves the allowlist" "$p/.practices/bin/check-size"
rm "$p/crates/app/src/big.rs"
expect 1 "a gone file leaves the allowlist" "$p/.practices/bin/check-size"
rm "$p/.practices/size-allowlist"
mkdir -p "$p/crates/app/tests" "$p/vendor/x"
lines 900 >"$p/crates/app/tests/flow.rs"
lines 900 >"$p/vendor/x/lib.rs"
expect 0 "integration tests get 1000, vendor is excluded" "$p/.practices/bin/check-size"

# --- check-unsafe
p=$(project)
echo 'fn a() {} // unsafe in a comment' >"$p/crates/app/src/lib.rs"
expect 0 "unsafe in a comment passes" "$p/.practices/bin/check-unsafe"
echo 'fn b() { unsafe { std::env::set_var("A", "1") } }' >"$p/crates/app/src/sys.rs"
expect 1 "unsafe code fails" "$p/.practices/bin/check-unsafe"
mkdir -p "$p/crates/app-os/src"
mv "$p/crates/app/src/sys.rs" "$p/crates/app-os/src/sys.rs"
echo "UNSAFE_ALLOWED='crates/app-os'" >>"$p/.practices/config"
expect 0 "unsafe in the allowed crate passes" "$p/.practices/bin/check-unsafe"
echo "#![forbid(unsafe_code)]" >"$p/crates/app/src/main.rs"
expect 0 "forbid(unsafe_code) isn't unsafe code" "$p/.practices/bin/check-unsafe"

# --- check-private
p=$(project)
: >"$p/.practices/config"
expect 1 "no terms file fails (fails closed)" "$p/.practices/bin/check-private"
expect 0 "in CI without a secret it skips, saying so" env CI=true "$p/.practices/bin/check-private"
mkdir -p "$p/dev"
printf '# clients\nGlobexCorp\n' >"$p/dev/private-terms"
expect 1 "a terms file git doesn't ignore fails" "$p/.practices/bin/check-private"
echo dev/private-terms >"$p/.gitignore"
expect 0 "clean files pass" "$p/.practices/bin/check-private"
echo 'let host = "vpn.globexcorp.example";' >"$p/crates/app/src/lib.rs"
expect 1 "a new file naming a client fails" "$p/.practices/bin/check-private"
git -C "$p" add crates/app/src/lib.rs
expect 1 "a staged file naming a client fails" "$p/.practices/bin/check-private"
git -C "$p" rm -q --cached crates/app/src/lib.rs
rm "$p/crates/app/src/lib.rs" "$p/dev/private-terms"
expect 0 "the env secret stands in for the file" env CI=true PRACTICES_PRIVATE_TERMS=Initrode "$p/.practices/bin/check-private"
echo "Initrode" >"$p/README"
expect 1 "and is searched with" env CI=true PRACTICES_PRIVATE_TERMS=Initrode "$p/.practices/bin/check-private"
rm "$p/README"
printf 'GlobexCorp\n' >"$p/dev/private-terms"

# --- check-commit-msg
printf 'Fix the thing\n\nCo-Authored-By: Claude <noreply@anthropic.com>\n' >"$work/m1"
expect 0 "a plain message with Co-Authored-By passes" "$p/.practices/bin/check-commit-msg" "$work/m1"
printf 'Fix\n\nClaude-Session: https://claude.ai/code/session_01AbCdEfGhIjKlMnOpQrStUv\n' >"$work/m2"
expect 1 "a session trailer fails" "$p/.practices/bin/check-commit-msg" "$work/m2"
printf 'Fix\n\nSee https://claude.ai/code/session_01AbCdEfGhIjKlMnOpQrStUv\n' >"$work/m3"
expect 1 "a session link fails" "$p/.practices/bin/check-commit-msg" "$work/m3"
printf 'Keep sessions alive\n\nSession handling: retried once.\n' >"$work/m4"
expect 0 "the word session alone passes" "$p/.practices/bin/check-commit-msg" "$work/m4"
printf 'Talk to GlobexCorp\n' >"$work/m5"
expect 1 "a message naming a client fails" "$p/.practices/bin/check-commit-msg" "$work/m5"
printf 'Fix\n# GlobexCorp in a comment line\n' >"$work/m6"
expect 0 "comment lines aren't the message" "$p/.practices/bin/check-commit-msg" "$work/m6"

# --- check-commit-msg: a touch-up to a board names its before/after page
p=$(project)
echo "COPY_LANG=en" >>"$p/.practices/config" # its boards name no language
mkdir -p "$p/design/changes"
printf '<p>Board</p>\n' >"$p/design/board.html"
git -C "$p" add design/board.html && git -C "$p" commit -q -m "A board"
printf '<p>Board, touched up</p>\n' >"$p/design/board.html"
printf '<p>New</p>\n' >"$p/design/new.html"
git -C "$p" add design/new.html
printf 'Add a board\n' >"$work/ba0"
expect 0 "a new board needs no before/after" "$p/.practices/bin/check-commit-msg" "$work/ba0"
git -C "$p" add design/board.html
expect 1 "a changed board without Before-after: fails" "$p/.practices/bin/check-commit-msg" "$work/ba0"
printf 'Touch up\n\nBefore-after: design/changes/board.html\n' >"$work/ba1"
expect 1 "a Before-after: page that isn't there fails" "$p/.practices/bin/check-commit-msg" "$work/ba1"
printf '<p>Before, after</p>\n' >"$p/design/changes/board.html"
expect 0 "a Before-after: page in the repository passes" "$p/.practices/bin/check-commit-msg" "$work/ba1"
printf 'Touch up\n\nBefore-after: https://example.com/changes/board\n' >"$work/ba2"
expect 0 "a Before-after: link passes" "$p/.practices/bin/check-commit-msg" "$work/ba2"
printf 'Touch up\n\nBefore-after: none, reindented\n' >"$work/ba3"
expect 1 "Before-after: none without a reason fails" "$p/.practices/bin/check-commit-msg" "$work/ba3"
printf 'Touch up\n\nBefore-after: none, only the markup was reindented\n' >"$work/ba4"
expect 0 "Before-after: none with its reason passes" "$p/.practices/bin/check-commit-msg" "$work/ba4"
printf 'Touch up\n# Before-after: design/changes/board.html\n' >"$work/ba5"
expect 1 "a Before-after: in a comment line isn't the trailer" "$p/.practices/bin/check-commit-msg" "$work/ba5"
"$p/.practices/bin/install-hooks" >/dev/null
expect 1 "the commit-msg hook refuses a touched-up board without its page" git -C "$p" commit -q -F "$work/ba0"
expect 0 "and lets it through with its page" git -C "$p" commit -q -F "$work/ba2"

# --- install-hooks
p=$(project)
expect 1 "hooks not installed fails the check" "$p/.practices/bin/install-hooks" --check
expect 0 "installing" "$p/.practices/bin/install-hooks"
expect 0 "installed passes the check" "$p/.practices/bin/install-hooks" --check
printf 'Fix\n\nClaude-Session: abc\n' >"$work/m7"
expect 1 "the commit-msg hook refuses a session trailer" git -C "$p" commit -q --allow-empty -F "$work/m7"
expect 0 "the hooks let a clean commit through" git -C "$p" commit -q --allow-empty -m "Start"

# --- claude-hook: which commands run the lint gate (lint and the disk
# guard replaced by stand-ins that record their runs)
p=$(project)
printf '#!/bin/sh\necho run >>"%s/lint-runs"\n' "$p" >"$p/.practices/bin/lint"
printf '#!/bin/sh\nexit 0\n' >"$p/.practices/bin/disk-guard"
hook() { printf '{"tool_input":{"command":"%s"}}' "$1" | "$p/.practices/bin/claude-hook"; }
runs() { [ -f "$p/lint-runs" ] && wc -l <"$p/lint-runs" | tr -d ' ' || echo 0; }
for c in "cargo build" "cargo test -p app" "nice -n 19 cargo clippy --workspace" "cd x && cargo run" "cargo +nightly check" "cargo nextest run"; do
    before=$(runs)
    hook "$c" >/dev/null 2>&1
    [ "$(runs)" -gt "$before" ] && ok || bad "claude-hook runs lint after: $c"
done
for c in "ls" "cargo fmt" "git commit -m 'cargo build'" "cargo tree"; do
    before=$(runs)
    hook "$c" >/dev/null 2>&1
    [ "$(runs)" = "$before" ] && ok || bad "claude-hook leaves lint alone after: $c"
done
printf '#!/bin/sh\necho "disk: 12 GB free"; exit 1\n' >"$p/.practices/bin/disk-guard"
expect 1 "a disk under its floor stops the agent" hook "ls"

# --- a project in another language: the hooks guard it, and cargo never
# runs (a stand-in cargo records it if anything calls it)
p=$work/web$RANDOM
mkdir -p "$p" "$work/nocargo"
git -C "$p" init -q
git -C "$p" config user.email t@example.com
git -C "$p" config user.name t
printf '#!/bin/sh\necho "$*" >>"%s/cargo-runs"\nexit 1\n' "$work" >"$work/nocargo/cargo"
chmod +x "$work/nocargo/cargo"
nocargo() { PATH="$work/nocargo:$PATH" "$@"; }
nocargo "$here/bin/install" --templates "$p" >/dev/null
[ ! -e "$p/.practices/coverage-floors" ] && [ ! -e "$p/deny.toml" ] && [ ! -e "$p/rust-toolchain.toml" ] && ok ||
    bad "install puts nothing of Rust's into a project without Cargo.toml"
mkdir -p "$p/dev"
printf 'dev/private-terms\n' >"$p/.gitignore"
printf 'GlobexCorp\n' >"$p/dev/private-terms"
expect 0 "installing the hooks there" nocargo "$p/.practices/bin/install-hooks"
echo '<h1>Hello</h1>' >"$p/index.html"
git -C "$p" add -A
expect 0 "a clean commit goes through both hooks" nocargo git -C "$p" commit -q -m "Start the site"
echo '<p>Built for GlobexCorp</p>' >"$p/about.html"
git -C "$p" add about.html
expect 1 "the pre-commit hook refuses a client's name in a file" nocargo git -C "$p" commit -q -m "Add about"
git -C "$p" rm -q --cached about.html
rm "$p/about.html"
printf 'Fix\n\nClaude-Session: https://claude.ai/code/session_01AbCdEfGhIjKlMnOpQrStUv\n' >"$work/m8"
expect 1 "the commit-msg hook refuses a session link" nocargo git -C "$p" commit -q --allow-empty -F "$work/m8"
[ ! -e "$work/cargo-runs" ] && ok || bad "cargo ran in a project without Rust" "$(cat "$work/cargo-runs")"

# --- a JavaScript/TypeScript project: the gate, sizes, the hooks
p=$(project)
rm -rf "$p/crates"
printf '{"name":"app","scripts":{}}\n' >"$p/package.json"
printf '{}\n' >"$p/tsconfig.json"
mkdir -p "$p/src" "$p/__tests__" "$work/npmshim"
log=$work/npm-calls
# fake npm and npx: they log their arguments and fail when told to
for tool in npm npx; do
    {
        echo '#!/bin/sh'
        echo "echo \"$tool \$*\" >>\"$log\""
        echo "case \" \$* \" in *\" \$FAIL_ON \"*) echo \"$tool failed: \$*\"; exit 1 ;; esac"
        echo 'echo "lots of test output"'
        echo 'exit 0'
    } >"$work/npmshim/$tool"
    chmod +x "$work/npmshim/$tool"
done
npmshim() { PATH="$work/npmshim:$PATH" FAIL_ON="${FAIL_ON:-none}" "$@"; }
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
"$p/.practices/bin/install-hooks" >/dev/null
: >"$log"
expect 0 "a JS project's gate passes" npmshim "$p/.practices/bin/lint"
grep -q 'npx --no-install tsc --noEmit' "$log" && grep -q 'npm run --silent lint' "$log" && ! grep -q cargo "$log" && ok ||
    bad "a JS project's gate runs tsc and npm run lint, and no cargo" "$(cat "$log")"
FAIL_ON=lint expect 1 "a failing npm check fails the gate" npmshim "$p/.practices/bin/lint"
printf 'PRIVATE_TERMS=none\nNPM_CHECKS="lint changelog:check"\n' >"$p/.practices/config"
: >"$log"
npmshim "$p/.practices/bin/lint" >/dev/null
grep -q 'npm run --silent changelog:check' "$log" && ok || bad "NPM_CHECKS names the npm scripts the gate runs" "$(cat "$log")"
lines 700 >"$p/src/ok.ts"
lines 701 >"$p/src/Big.tsx"
expect 1 "a 701-line .tsx fails the size check" "$p/.practices/bin/check-size"
mv "$p/src/Big.tsx" "$p/__tests__/big.tsx"
expect 0 "a test file may reach SIZE_TESTS" "$p/.practices/bin/check-size"
lines 1001 >"$p/__tests__/big.tsx"
expect 1 "a test file past SIZE_TESTS fails" "$p/.practices/bin/check-size"
rm "$p/__tests__/big.tsx"
lines 900 >"$p/src/strings.generated.ts"
printf 'PRIVATE_TERMS=none\nSIZE_EXCLUDE=%s\n' "'\\.generated\\.ts\$'" >"$p/.practices/config"
expect 0 "SIZE_EXCLUDE leaves generated files out" "$p/.practices/bin/check-size"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
rm "$p/src/strings.generated.ts"
git -C "$p" add -A
: >"$log"
expect 0 "a JS commit goes through the hooks" npmshim git -C "$p" commit -q -m "Start the app"
PATH="$work/npmshim:$PATH" FAIL_ON=none git -C "$p" commit -q --amend -m "Start the app" >"$work/commit-out" 2>&1
! grep -q 'lots of test output' "$work/commit-out" && ok || bad "pre-commit is quiet when the tests pass" "$(cat "$work/commit-out")"
grep -q 'npm run --silent test' "$log" && grep -q 'npm run --silent lint' "$log" && ok ||
    bad "pre-commit runs the gate and the tests when JS files are committed" "$(cat "$log")"
echo 'export const b = 2;' >"$p/src/b.ts"
git -C "$p" add src/b.ts
FAIL_ON='test' expect 1 "pre-commit refuses a commit whose tests fail" npmshim git -C "$p" commit -q -m "Add b"
git -C "$p" reset -q
expect 0 "disk-guard leaves a project without Rust alone" "$p/.practices/bin/disk-guard"
mv "$p/.practices/bin/lint" "$p/.practices/bin/lint.real"
printf '#!/bin/sh\necho ran >>"%s"\n' "$work/js-lint-runs" >"$p/.practices/bin/lint"
chmod +x "$p/.practices/bin/lint"
for c in 'npm test' 'npm run verify' 'nice -n 19 npx jest --silent' 'npx --no-install tsc --noEmit' 'npm run lint'; do
    rm -f "$work/js-lint-runs"
    printf '{"tool_input":{"command":"%s"}}' "$c" | "$p/.practices/bin/claude-hook" >/dev/null 2>&1
    [ -s "$work/js-lint-runs" ] && ok || bad "claude-hook runs lint after: $c"
done
for c in 'npm install' 'npm run start' 'npx react-native start'; do
    rm -f "$work/js-lint-runs"
    printf '{"tool_input":{"command":"%s"}}' "$c" | "$p/.practices/bin/claude-hook" >/dev/null 2>&1
    [ ! -e "$work/js-lint-runs" ] && ok || bad "claude-hook leaves lint alone after: $c"
done

# --- bin/install keeps what the project owns
p=$(project)
touch "$p/Cargo.toml"
echo "SIZE_CODE=900" >"$p/.practices/config"
"$here/bin/install" --templates "$p" >/dev/null
grep -q SIZE_CODE=900 "$p/.practices/config" && ok || bad "install keeps .practices/config"
[ -f "$p/deny.toml" ] && [ -f "$p/rust-toolchain.toml" ] && [ -f "$p/.github/dependabot.yml" ] && ok || bad "install --templates copies the templates"
echo "# mine" >"$p/deny.toml"
"$here/bin/install" --templates "$p" >/dev/null
[ "$(cat "$p/deny.toml")" = "# mine" ] && ok || bad "install never overwrites a project's template copy"

# --- bin/install gives agents the rules, the docs and the skills
p=$(project)
printf '# Mine\n\nOur rules.\n' >"$p/CLAUDE.md"
rm -rf "$p/.claude/skills" "$p/.practices/skills" # as before the kit had skills
mkdir -p "$p/.claude/skills/ours" "$p/.claude/skills/practices-testing"
echo ours >"$p/.claude/skills/ours/SKILL.md"
echo ours >"$p/.claude/skills/practices-testing/SKILL.md"
out=$("$here/bin/install" "$p")
grep -qxF '@.practices/rules.md' "$p/CLAUDE.md" && grep -q 'Our rules.' "$p/CLAUDE.md" && ok ||
    bad "install adds the line that loads rules.md and keeps CLAUDE.md" "$(cat "$p/CLAUDE.md")"
grep -q '^- Red before green$' "$p/.practices/rules.md" && grep -q 'identity-pass.md' "$p/.practices/rules.md" && ok ||
    bad "rules.md lists every practice's rules" "$(cat "$p/.practices/rules.md")"
! grep -q 'rust/conventions.md' "$p/.practices/rules.md" && ok || bad "rules.md leaves Rust out of a project without Cargo.toml"
! grep -qx -e '- Unreleased' "$p/.practices/rules.md" && ok || bad "rules.md skips headings inside code examples"
[ -f "$p/.practices/docs/ui/visual-craft.md" ] && [ -f "$p/.practices/docs/common/testing.md" ] && ok ||
    bad "install copies the practices into .practices/docs"
[ -f "$p/.claude/skills/practices-ui-design/SKILL.md" ] && [ ! -e "$p/.claude/skills/fold-in-a-project" ] && ok ||
    bad "install copies the kit's skills, not fold-in-a-project" "$(ls "$p/.claude/skills")"
[ "$(cat "$p/.claude/skills/practices-testing/SKILL.md")" = ours ] && ! grep -qx practices-testing "$p/.practices/skills" && ok ||
    bad "install keeps a project's skill with the kit's name"
case $out in *"Restart your agent session"*) ok ;; *) bad "install says to restart the agent session" "$out" ;; esac
printf 'gone\n' >>"$p/.practices/skills"
mkdir -p "$p/.claude/skills/gone"
"$here/bin/install" "$p" >/dev/null
[ "$(grep -cxF '@.practices/rules.md' "$p/CLAUDE.md")" = 1 ] && ok || bad "install adds the CLAUDE.md line only once"
[ ! -e "$p/.claude/skills/gone" ] && [ -f "$p/.claude/skills/ours/SKILL.md" ] && ok ||
    bad "an update removes the kit's old skills and keeps the project's"
touch "$p/Cargo.toml"
"$here/bin/install" "$p" >/dev/null
grep -q 'rust/conventions.md' "$p/.practices/rules.md" && ! grep -q 'rust/gpui.md' "$p/.practices/rules.md" && ok ||
    bad "rules.md adds Rust's rules to a Rust project, GPUI's only with GPUI"
rm -rf "$p/CLAUDE.md"
"$here/bin/install" "$p" >/dev/null
grep -qxF '@.practices/rules.md' "$p/CLAUDE.md" && ok || bad "install creates a CLAUDE.md that loads rules.md"
grep -q 'practices-update.yml@v1' "$p/.github/workflows/practices.yml" && ok ||
    bad "install adds the workflow that pulls updates"
echo "# ours" >"$p/.github/workflows/practices.yml"
"$here/bin/install" "$p" >/dev/null
[ "$(cat "$p/.github/workflows/practices.yml")" = "# ours" ] && ok || bad "install keeps the project's update workflow"

# --- check-shots: a live switch draws what a fresh start draws (mobile/devices.md)
p=$(project)
node "$here/tests/shots/make.mjs" "$work/shots"
shots="$p/.practices/bin/check-shots"
expect 0 "check-shots passes two identical screens" "$shots" "$work/shots/same/fresh" "$work/shots/same/live"
out=$("$shots" "$work/shots/glyph/fresh" "$work/shots/glyph/live" 2>&1)
[ $? = 1 ] && grep -q 'switcher.png: 7×21 px differ at 60,40' <<<"$out" && ok ||
    bad "check-shots finds the lost glyph and says where" "$out"
expect 1 "check-shots finds a status bar that differs unless told to skip it" "$shots" "$work/shots/clock/fresh" "$work/shots/clock/live"
expect 0 "check-shots skips the status bar it is told to" "$shots" --skip-top 12 "$work/shots/clock/fresh" "$work/shots/clock/live"
out=$("$shots" "$work/shots/size/fresh" "$work/shots/size/live" 2>&1)
[ $? = 1 ] && grep -q 'not the same screen size' <<<"$out" && ok || bad "check-shots refuses screens of two sizes" "$out"
rm "$work/shots/same/live/switcher.png"
out=$("$shots" "$work/shots/same/fresh" "$work/shots/same/live" 2>&1)
[ $? = 2 ] && grep -q 'shoot every screen both ways' <<<"$out" && ok ||
    bad "check-shots fails when a screen was shot only one way" "$out"

# --- check-ui: each check catches its planted fault, and only clean boards pass
# (common/gates.md, "Prove the gate can fail"). Needs Node and Chrome: on a
# machine without them these fail, as the gate itself does.
p=$(project)
mkdir -p "$p/design"
expect 0 "check-ui with no boards passes, saying so" "$p/.practices/bin/check-ui"
for f in "$here"/tests/ui/*.html; do
    name=$(basename "$f" .html)
    cp "$f" "$p/design/$name.html"
    out=$("$p/.practices/bin/check-ui" "design/$name.html" 2>&1)
    status=$?
    case $name in
    clean | allowed | covered | covered-wide | align-forward | mark-ok | skips | skips-* | rounded | ink-ok | inset-ok | inset-under | inset-drawing | halo-ink)
        [ $status = 0 ] && ok || bad "check-ui passes tests/ui/$name.html" "$out" ;;
    *)
        rule=$name
        case $name in contrast-*) rule=contrast ;; text-size-*) rule=text-size ;; outcome-*) rule=outcome ;; allow-unreasoned) rule=allow ;; align-stretched) rule=align ;; mark-*) rule=mark ;; safe-*) rule=safe ;; width-own) rule=contain ;; same-look-*) rule=same-look ;; esac
        # A here-string, not a pipe: under pipefail, grep -q leaving at the first match broke
        # printf's pipe and failed a passing case (1.6.5's pre-commit run on contain).
        [ $status = 1 ] && grep -q "^\[$rule\]" <<<"$out" && ok ||
            bad "check-ui catches tests/ui/$name.html as [$rule] (exit $status)" "$out" ;;
    esac
    rm "$p/design/$name.html"
done
cp "$here/tests/ui/contain.html" "$p/design/board.html"
out=$("$p/.practices/bin/check-ui" 2>&1)
case $out in *'"Choose a Folder…" runs'*'past the right of div.card'*) ok ;; *) bad "check-ui finds the boards by UI_BOARDS and names the element and the edge" "$out" ;; esac
cp "$here/tests/ui/same-look-unnamed.html" "$p/design/board.html"
out=$("$p/.practices/bin/check-ui" 2>&1)
case $out in *'These have no class: name each component'*) ok ;; *) bad "check-ui's same-look asks unclassed buttons to name their component" "$out" ;; esac
# A board with no dark rules renders in one theme; one with them, in both (Scops: 348 renders where 87 would do).
cp "$here/tests/ui/clean.html" "$p/design/board.html"
out=$("$p/.practices/bin/check-ui" 2>&1)
case $out in *'1 board, 2 renders ('*) ok ;; *) bad "check-ui renders a board with no dark rules in one theme" "$out" ;; esac
# A fixed-width board's width, from canvas.json beside it (the viewport meta is tests/ui/width-own.html).
sed 's|<meta name="viewport" content="width=390">||' "$here/tests/ui/safe-frame.html" >"$p/design/board.html"
printf '{"boards": {"board.html": {"w": 390}}}\n' >"$p/design/canvas.json"
out=$("$p/.practices/bin/check-ui" 2>&1)
case $out in *'drawn 390 px wide, a phone'*'1 render ('*) ok ;; *) bad "check-ui renders a board at the width canvas.json gives it" "$out" ;; esac
rm "$p/design/canvas.json"
echo "UI_CHROME=$work/no-chrome" >>"$p/.practices/config"
"$p/.practices/bin/check-ui" >/dev/null 2>&1
st=$?
[ $st = 2 ] && ok || bad "check-ui without Chrome fails (exit 2), never passes"
printf 'PRIVATE_TERMS=none\nUI_CHROME=%s\n' "$here/tests/ui/fake-chrome" >"$p/.practices/config"
out=$("$p/.practices/bin/check-ui" 2>&1)
st=$?
[ $st = 2 ] && case $out in *"Chrome didn't open a page in 3 tries"*) true ;; *) false ;; esac && ok ||
    bad "check-ui with a Chrome that opens no page fails (exit 2), saying so (exit $st)" "$out"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"

# --- check-copy: each language's rules on its own copy, the language always
# named, a fact read the same on every board, exceptions with their reason.
p=$(project)
expect 0 "check-copy with no copy files passes, saying so" "$p/.practices/bin/check-copy"
cp -R "$here/tests/copy/clean/." "$p/"
expect 0 "check-copy passes copy that keeps its language's grammar" "$p/.practices/bin/check-copy"
cp -R "$here/tests/copy/bad/." "$p/"
out=$("$p/.practices/bin/check-copy" 2>&1)
st=$?
[ $st = 1 ] && ok || bad "check-copy fails on copy that breaks its grammar (exit $st)" "$out"
for want in 'design/board.html:2 "Ve 10:20": the hour is said "deset", so "V 10:20"' '"v středu" is "ve středu"' \
    'es.json:1 "a el" is "al"' 'strings.ts:3 "a hour" is "an hour"' 'pl.json 1 piece of copy in "pl", and no rules for it' \
    'note.md 1 piece of copy names no language' 'data-allow="copy: brand" gives no reason' '"practices-allow copy: name" gives no reason' \
    '"swim" reads 2 ways: "St 16:30"' '"St 17:00"' '"z SÚKL" is "ze SÚKL"'; do
    case $out in *"$want"*) ok ;; *) bad "check-copy finds $want" "$out" ;; esac
done
out=$("$p/.practices/bin/check-copy" design/week.html 2>&1)
case $out in *'"swim" reads 2 ways'*) ok ;; *) bad "check-copy FILE compares its facts with every board" "$out" ;; esac
echo "COPY_LANG=en" >>"$p/.practices/config"
out=$("$p/.practices/bin/check-copy" 2>&1)
case $out in *'note.md'*) bad "COPY_LANG names the language of copy that names none" "$out" ;; *) ok ;; esac
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
# The gate runs where the others do: after an edit, before a commit, in lint.
p=$(project)
"$p/.practices/bin/install-hooks" >/dev/null
mkdir -p "$p/design"
cp "$here/tests/copy/clean/design/board.html" "$p/design/board.html"
ev() { printf '{"hook_event_name":"%s","tool_name":"%s","tool_input":{"command":"%s"},"stop_hook_active":%s}' "$1" "$2" "${3:-}" "${4:-false}"; }
mv "$p/.practices/bin/check-ui" "$p/.practices/bin/check-ui.real" # the copy gate alone: no Chrome needed here
printf '#!/bin/sh\nexit 0\n' >"$p/.practices/bin/check-ui"
chmod +x "$p/.practices/bin/check-ui"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes copy that keeps its grammar"
cp "$here/tests/copy/bad/design/board.html" "$p/design/board.html"
out=$(ev PostToolUse Edit | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'[v-ve-time]'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands the copy's grammar back to the agent" "$out"
out=$("$p/.practices/bin/lint" 2>&1)
st=$?
[ $st != 0 ] && case $out in *"the copy's grammar failed"*'[v-ve-time]'*) true ;; *) false ;; esac && ok ||
    bad "lint fails while the copy breaks its grammar" "$out"
git -C "$p" add design/board.html
git -C "$p" commit -qm "Board" >/dev/null 2>&1 && bad "pre-commit refuses copy that breaks its grammar" || ok
cp "$here/tests/copy/clean/design/board.html" "$p/design/board.html"
git -C "$p" add design/board.html
git -C "$p" commit -qm "Board" >/dev/null 2>&1 && ok || bad "pre-commit lets copy that keeps its grammar through"

# --- check-voice: every "we" in the copy, in each language and format it
# reads; nothing in comments, keys, or the person's own words.
p=$(project)
expect 0 "check-voice with no copy files passes, saying so" "$p/.practices/bin/check-voice"
cp -R "$here/tests/voice/clean/." "$p/"
expect 0 "check-voice passes copy that speaks as the app" "$p/.practices/bin/check-voice"
cp -R "$here/tests/voice/bad/." "$p/"
out=$("$p/.practices/bin/check-voice" 2>&1)
st=$?
[ $st = 1 ] && ok || bad "check-voice fails on we in the copy (exit $st)" "$out"
for want in 'strings.ts:2 [cs]' '"jsme"' '"Upozorníme"' '"my"' "\"we'll\"" '"us"' '"neprodáváme"' '"Our"' \
    'Localizable.strings:1 [cs]' '"Odešleme"' 'strings.xml:3 [cs]' '"uložíme"' 'app.xcstrings:7 [cs]' '"Pošleme"' 'without its reason' \
    '"WE"' '"We keep it for you." says' 'Notice.tsx:3' 'CHANGELOG.md:7' 'content/faq.ts:2'; do
    case $out in *"$want"*) ok ;; *) bad "check-voice finds $want" "$out" ;; esac
done
case $out in *'Welcome'* | *'comments for translators'* | *'never read'*) bad "check-voice reads only strings people see" "$out" ;; *) ok ;; esac

# --- claude-hook: the UI gate after any edit to a board, and before the turn ends
ev() { printf '{"hook_event_name":"%s","tool_name":"%s","tool_input":{"command":"%s"},"stop_hook_active":%s}' "$1" "$2" "${3:-}" "${4:-false}"; }
p=$(project)
mkdir -p "$p/design"
cp "$here/tests/ui/clean.html" "$p/design/board.html"
ev PostToolUse Write | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes a clean board"
cp "$here/tests/ui/contain.html" "$p/design/board.html" # a shell edit, no Edit tool
out=$(ev PostToolUse Bash "cp a b" | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'[contain]'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands a board's findings back (exit 2) after a shell edit" "$out"
ev PostToolUse Read | "$p/.practices/bin/claude-hook" >/dev/null 2>&1
st=$?
[ $st = 2 ] && ok || bad "claude-hook keeps reporting a failing board until it is fixed"
out=$(ev Stop "" "" false | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'You may not stop yet'*) true ;; *) false ;; esac && ok ||
    bad "the Stop hook blocks the turn's end while a board fails" "$out"
out=$(ev Stop "" "" true | "$p/.practices/bin/claude-hook" 2>/dev/null)
st=$?
[ $st = 0 ] && case $out in *systemMessage*'still open in design/board.html'*) true ;; *) false ;; esac && ok ||
    bad "blocked twice on the same findings, the agent may stop and the person is told" "$out"
cp "$here/tests/ui/clean.html" "$p/design/other.html"
printf 'PRIVATE_TERMS=none\nUI_BOARDS=design/other.html\n' >"$p/.practices/config"
ev PostToolUse Read | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "claude-hook stops checking a failing board once the gate no longer reads it"
printf 'PRIVATE_TERMS=none\n' >"$p/.practices/config"
cp "$here/tests/ui/clean.html" "$p/design/board.html"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ev Stop "" "" false | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok ||
    bad "once the board is fixed, edits and the turn's end pass"

# The voice gate: after an edit, before the turn ends, before a commit, in lint.
p=$(project)
"$p/.practices/bin/install-hooks" >/dev/null
mkdir -p "$p/src/i18n"
printf "const en = {\n  'a': 'Saved.',\n};\n" >"$p/src/i18n/strings.ts"
ev PostToolUse Edit | "$p/.practices/bin/claude-hook" >/dev/null 2>&1 && ok || bad "claude-hook passes copy without we"
printf "const en = {\n  'a': 'We saved it.',\n};\n" >"$p/src/i18n/strings.ts"
out=$(ev PostToolUse Edit | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'[voice]'*'"We"'*) true ;; *) false ;; esac && ok ||
    bad "claude-hook hands we in the copy back to the agent" "$out"
out=$(ev Stop "" "" false | "$p/.practices/bin/claude-hook" 2>&1)
st=$?
[ $st = 2 ] && case $out in *'You may not stop yet'*'[voice]'*) true ;; *) false ;; esac && ok ||
    bad "the Stop hook blocks while the copy says we" "$out"
out=$("$p/.practices/bin/lint" 2>&1)
st=$?
[ $st != 0 ] && case $out in *"the product's voice failed"*'"We"'*) true ;; *) false ;; esac && ok ||
    bad "lint fails while the copy says we" "$out"
git -C "$p" add src/i18n/strings.ts
git -C "$p" commit -qm "Copy" >/dev/null 2>&1 && bad "pre-commit refuses copy that says we" || ok
printf "const en = {\n  'a': 'Saved.',\n};\n" >"$p/src/i18n/strings.ts"
git -C "$p" add src/i18n/strings.ts
git -C "$p" commit -qm "Copy" >/dev/null 2>&1 && ok || bad "pre-commit lets copy without we through"

# --- pre-commit: a failing board can't be committed; nor can unwired hooks
p=$(project)
"$p/.practices/bin/install-hooks" >/dev/null
mkdir -p "$p/design"
cp "$here/tests/ui/contain.html" "$p/design/board.html"
git -C "$p" add design/board.html
git -C "$p" commit -qm "Add a board" >/dev/null 2>&1 && bad "pre-commit refuses a board that fails check-ui" || ok
cp "$here/tests/ui/clean.html" "$p/design/board.html"
git -C "$p" add design/board.html
git -C "$p" commit -qm "Add a board" >/dev/null 2>&1 && ok || bad "pre-commit lets a clean board through"
mkdir -p "$p/.claude"
cp "$here/templates/claude-settings.json" "$p/.claude/settings.json"
expect 0 "check-hooks passes the template" "$p/.practices/bin/check-hooks"
printf '{"hooks":{"PostToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"x/.practices/bin/claude-hook"}]}]}}\n' >"$p/.claude/settings.json"
out=$("$p/.practices/bin/check-hooks" 2>&1)
st=$?
[ $st = 1 ] && case $out in *'after Edit'*'Stop'*) true ;; *) false ;; esac && ok ||
    bad "check-hooks finds edits and Stop unwired" "$out"
git -C "$p" add .claude/settings.json
git -C "$p" commit -qm "Settings" >/dev/null 2>&1 && bad "pre-commit refuses settings that drop the hooks" || ok
# shellcheck disable=SC2016 # $CLAUDE_PROJECT_DIR is for Claude Code to expand
printf '{"hooks":{"PostToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"\\"$CLAUDE_PROJECT_DIR\\"/.practices/bin/claude-hook","timeout":900}]}]}}\n' >"$p/.claude/settings.json"
cp "$p/.claude/settings.json" "$work/old-settings"
"$here/bin/install" "$p" >/dev/null
cmp -s "$p/.claude/settings.json" "$here/templates/claude-settings.json" && bad "install leaves settings the project changed alone" || ok

echo "$passed passed, $failed failed"
[ $failed = 0 ]
