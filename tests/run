struct Today: View {
    var body: some View {
        ViewThatFits(in: .horizontal) {
            Text("this week \u{00B7} \(total) in all", comment: "Under the count · one line")
                .lineLimit(1)
            VStack(alignment: .leading) {
                Text("this week")
                Text("\(total) in all")
            }
        }
        Text("AVG \(avg) · LIMIT \(limit)").fixedSize()
        Text("\(days) clean days\u{00A0}·\u{00A0}\(level). They'll get it as a notification.")
        (Text("\(closed) closed") + Text(" · ").foregroundStyle(.gray) + Text(calls))
        (Text("\(closed) closed") + Text(" · ") + Text(calls))
            .lineLimit(1)
        // Text("a · b") in a comment
        let label = "a · b"
        // practices-allow join: the dot is quoted, not a separator
        Text("Write a · between them")
        Text("Trends", comment: "A title · not joined")
    }
}
SWIFT
out=$("$p/.practices/bin/check-views" 2>&1)
st=$?
[ $st = 1 ] && case $out in *'Today.swift:13 '*) true ;; *) false ;; esac && ok ||
    bad "check-views reads a sum of Texts in parentheses as one that may wrap (exit $st)" "$out"
