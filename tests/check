#!/usr/bin/env bash
# This repository's own gate: CI's static checks (shellcheck on every
# script, every relative link, README's map, the plugin's version, every
# rule classified in ENFORCEMENT.md), then
# the kit's tests. Quiet when it passes.
# The pre-commit hook in .githooks runs it (once per clone:
# `git config core.hooksPath .githooks`); CI's static job calls
# `tests/check static`, so the two can't drift.
#
#   tests/check          # shellcheck, links, readme, versions, tests/run
#   tests/check static   # all but tests/run (CI)
#
# Until 2026-11-12 these ran only in CI: a commit that failed shellcheck
# was pushed, and its release commit had to wait for a fix.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
fail=0
run() {
    local out
    if ! out=$("$@" 2>&1); then
        printf '%s failed:\n%s\n\n' "$*" "$out"
        fail=1
    fi
}
run shellcheck -x -P SCRIPTDIR scripts/lib.sh scripts/lint scripts/check-* scripts/claude-hook \
    scripts/disk-guard scripts/install-hooks hooks/* bin/install tests/run tests/example tests/links tests/check tests/readme tests/versions tests/enforcement tests/mutate \
    .githooks/pre-commit
run shellcheck -s sh scripts/prune-caches scripts/sweep-target
# macOS runs the kit's scripts with its own /bin/bash 3.2, which parses less
# than the bash 5 a developer has (2026-11-15: a heredoc inside $( ) that
# bash 5 read broke tests/mutate in CI). Parse each script with it too.
if [ -x /bin/bash ] && /bin/bash -c '[ "${BASH_VERSINFO[0]}" -lt 4 ]'; then
    for f in scripts/lib.sh scripts/lint scripts/check-* scripts/claude-hook scripts/disk-guard scripts/install-hooks \
        hooks/* bin/install tests/run tests/example tests/links tests/check tests/readme tests/versions tests/enforcement \
        tests/mutate .githooks/pre-commit; do
        head -1 "$f" | grep -q bash && run /bin/bash -n "$f"
    done
fi
run tests/links
run tests/readme
run tests/versions
run tests/enforcement
if [ "${1:-}" != static ]; then
    run tests/run
fi
exit $fail
