#!/usr/bin/env bash
# Mutation tests: proof that tests/run would notice a check that stopped
# checking. Each mutant breaks one line of one check, in a copy of the
# kit, and tests/run must then fail on that check's own case.
#
#   tests/mutate            # every mutant, JOBS at a time (default 4)
#   tests/mutate NAME...    # just these
#   SHARD=2/4 tests/mutate  # every 4th mutant, from the 2nd (CI runs 4 shards)
#
# Why: on 2026-11-15 an agent's ad-hoc mutation run reported every check
# "caught" while it measured nothing. Its copies sat outside a git
# repository, so every run failed before checking, and that failure was
# counted as a kill. Its baseline then read `$?` from the wrong command.
# So this runner guards itself:
# - mutants run in full copies of one snapshot of the kit, .git
#   included; the repository's own files are never changed;
# - the unmutated copy must pass tests/run first, or nothing counts;
# - a mutation that matches nothing fails the run (a no-op isn't a kill),
#   and so does one that leaves the script unable to parse;
# - a mutant counts as killed only when tests/run fails on the case named
#   for it. Failing for another reason (a crash, a refused start) is
#   reported, not counted.
set -uo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
jobs=${JOBS:-4}
shard=${SHARD:-1/1}
case $shard in
[1-9]/[1-9] | [1-9]/[1-9][0-9] | [1-9][0-9]/[1-9][0-9]) ;;
*) echo "tests/mutate: SHARD is K/N, as 2/4 (got \"$shard\")"; exit 2 ;;
esac
shard_k=${shard%/*} shard_n=${shard#*/}
[ "$shard_k" -le "$shard_n" ] || { echo "tests/mutate: SHARD $shard: K is more than N"; exit 2; }

# name ¦ file ¦ text to replace (literal) ¦ replacement ¦ the FAIL line tests/run must print.
# Fields are split at " ¦ ", which no script contains: an earlier "|" split
# cut rows whose code holds "||" and broke the mutated script instead.
# A quoted heredoc: no character in a row (an apostrophe, a $) can end it
# or expand. A single-quoted string ended at the first "product's". Read
# with `read`, not `$(cat <<…)`: macOS's bash 3.2 matches the parentheses
# inside a command substitution's heredoc, and a row's "add(" broke it.
