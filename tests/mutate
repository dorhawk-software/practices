ROWS

row() { # row LINE: the five fields, tab-separated
    local line=$1 sep=' ¦ ' name file from to want
    name=${line%%"$sep"*}; line=${line#*"$sep"}
    file=${line%%"$sep"*}; line=${line#*"$sep"}
    from=${line%%"$sep"*}; line=${line#*"$sep"}
    to=${line%%"$sep"*}; want=${line#*"$sep"}
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$file" "$from" "$to" "$want"
}

# The kit as it is when the run starts, uncommitted changes and .git
# included. Every copy comes from this snapshot: an edit made to the
# repository while the mutants run must not leak into some of them.
mkdir -p "$work/snap" && (cd "$here" && tar cf - .) | (cd "$work/snap" && tar xf -)
copy() { # copy DIR: a fresh copy of the snapshot
    mkdir -p "$1" && (cd "$work/snap" && tar cf - .) | (cd "$1" && tar xf -)
}

# 1. The baseline: an unmutated copy passes. Otherwise every "kill" below means nothing.
copy "$work/base"
if ! out=$("$work/base/tests/run" 2>&1); then
    printf 'tests/mutate: the unmutated copy fails tests/run, so no mutant can be judged:\n%s\n' "$out"
    exit 1
fi
echo "baseline: the unmutated copy passes tests/run"

run_one() { # run_one NAME FILE FROM TO WANT: writes $work/NAME.result
    local name=$1 file=$2 from=$3 to=$4 want=$5 dir=$work/m-$1 out status
    copy "$dir"
    if ! FROM=$from TO=$to perl -0pi -e '$n = s/\Q$ENV{FROM}\E/$ENV{TO}/g; END { exit($n ? 0 : 3) }' "$dir/$file"; then
        echo "no-op: \"$from\" isn't in $file (the mutant would change nothing)" >"$work/$name.result"
        return
    fi
    # A mutant that doesn't parse fails every case near it: that proves nothing.
    case $file in
    *.mjs) node --check "$dir/$file" >/dev/null 2>&1 ;;
    *.py) python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$dir/$file" >/dev/null 2>&1 ;;
    *) bash -n "$dir/$file" >/dev/null 2>&1 ;;
    esac || {
        echo "invalid: the mutated $file doesn't parse, so a failure would prove nothing" >"$work/$name.result"
        return
    }
    out=$("$dir/tests/run" 2>&1)
    status=$?
    if [ $status = 0 ]; then
        echo "SURVIVED: tests/run passes with $file broken" >"$work/$name.result"
    elif printf '%s\n' "$out" | grep -F 'FAIL: ' | grep -qF -- "$want"; then
        echo "killed" >"$work/$name.result"
    else
        printf 'killed for another reason (no FAIL line with "%s"):\n%s\n' "$want" "$(printf '%s\n' "$out" | grep -m 5 'FAIL\|error' || printf '%s\n' "$out" | tail -n 5)" >"$work/$name.result"
    fi
    rm -rf "$dir"
}

# 2. Every mutant (or the ones named), JOBS at a time.
picked=0 n=0 index=0
while IFS= read -r line; do
    [ -n "$line" ] || continue
    index=$((index + 1))
    IFS=$'\t' read -r name file from to want <<<"$(row "$line")"
    if [ -z "$name" ] || [ -z "$file" ] || [ -z "$from" ] || [ -z "$to" ] || [ -z "$want" ] || [ ! -f "$here/$file" ]; then
        echo "tests/mutate: a malformed row (five fields, split at \" ¦ \", on a file that exists): $line"
        exit 1
    fi
    if [ $# -gt 0 ]; then
        case " $* " in *" $name "*) ;; *) continue ;; esac
    fi
    [ $(((index - 1) % shard_n)) = $((shard_k - 1)) ] || continue # every row is still checked above
    picked=$((picked + 1))
    run_one "$name" "$file" "$from" "$to" "$want" &
    n=$((n + 1))
    if [ $n -ge "$jobs" ]; then
        wait
        n=0
    fi
done <<EOF
$mutants
EOF
wait
[ $picked -gt 0 ] || { echo "tests/mutate: no mutant named $*"; exit 1; }

failed=0
for r in "$work"/*.result; do
    name=$(basename "$r" .result)
    verdict=$(cat "$r")
    case $verdict in
    killed) printf '  killed    %s\n' "$name" ;;
    *) failed=$((failed + 1)); printf '  NOT KILLED %s: %s\n' "$name" "$verdict" ;;
    esac
done
echo "$picked mutants, $((picked - failed)) killed, $failed not"
[ $failed = 0 ]
