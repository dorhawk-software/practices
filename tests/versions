#!/usr/bin/env bash
# The plugin's version is the practices' version. Claude Code updates an
# installed plugin only when its version changes, so a plugin left at an old
# version never brings its new skills to anyone. This checks that
# plugin/.claude-plugin/plugin.json and .claude-plugin/marketplace.json both
# give the newest released version in CHANGELOG.md, and that the moving v1
# tag is on the newest v1.x.y tag. Quiet when it passes;
# tests/check runs it, so CI and the pre-commit hook do.
# Added 2026-11-12: the plugin was numbered on its own, so practices 1.2.0
# and 1.3.0 shipped it as 1.1.0, which read as stale next to the tags, and
# nothing said when the plugin's number had to move.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

released=$(sed -n 's/^## \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\) .*/\1/p' CHANGELOG.md | head -n 1)
if [ -z "$released" ]; then
    echo "CHANGELOG.md has no released version (a \"## 1.2.3 (date)\" heading)."
    exit 1
fi
fail=0
for file in plugin/.claude-plugin/plugin.json .claude-plugin/marketplace.json; do
    found=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$file")
    if [ -z "$found" ]; then
        echo "$file gives no version; it should say \"version\": \"$released\"."
        fail=1
    elif [ "$found" != "$released" ]; then
        echo "$file says version $found, but the newest release in CHANGELOG.md is $released. Set it to $released in the release commit."
        fail=1
    fi
done

# The moving v1 is on the newest 1.x tag: projects use the actions and
# workflows @v1, and the README promises it follows the newest release.
# Added 2026-11-23: v1 stayed at 1.9.2 through 1.10.0, 1.11.0, 1.12.0 and
# 1.12.1, and nothing said so. CI's static job fetches every tag; a clone
# without tags (a shallow one) is said so, not passed in silence.
newest=$(git tag -l 'v1.*.*' --sort=-v:refname | head -n 1)
if [ -z "$newest" ]; then
    echo "tests/versions: no v1.x.y tags here (a shallow clone?): v1 not checked. Run git fetch --tags."
elif [ -z "$(git tag -l v1)" ]; then
    echo "There is no v1 tag; it should point at $newest. Run: git tag -fa v1 -m \"Practices ${newest#v}\" $newest^{} && git push -f origin v1"
    fail=1
elif [ "$(git rev-parse 'v1^{}')" != "$(git rev-parse "$newest^{}")" ]; then
    at=$(git tag --points-at "$(git rev-parse 'v1^{}')" 'v1.*.*' | head -n 1)
    echo "v1 points at ${at:-$(git rev-parse --short 'v1^{}')}, but the newest release is $newest. Move it: git tag -fa v1 -m \"Practices ${newest#v}\" $newest^{} && git push -f origin v1 (if origin already has it, your local v1 is stale: git fetch --tags -f)."
    fail=1
fi
exit $fail
