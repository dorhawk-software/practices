#!/usr/bin/env bash
# The joins gate: a joined line breaks between its parts
# (ui/visual-craft.md). In the Swift files (MOTION_FILES, the same files
# check-motion reads) it finds a Text whose string joins parts with a
# separator (" · ", " | ") and may wrap: no .lineLimit(1), no horizontal
# .fixedSize. Wrapped, the dot ends one line or starts the next. The fix
# is ViewThatFits: the joined line where it fits, a line for each part,
# without the dot, where it doesn't. The reading is in join-audit.py;
# design boards are measured by check-ui (join).
#
#   .practices/bin/check-joins            # every Swift file
#   .practices/bin/check-joins FILE...    # just these
#
# A dot that isn't a separator is marked on the line or the line above,
# with a reason of three words or more:
#   // practices-allow join: the dot is quoted, not a separator
#
# Why: on 25 Nov 2026 an iPhone app's Today read "tento týden ·" over
# "celkem 18": .lineLimit(2) let the joined line wrap at its dot. A
# string built elsewhere and shown with Text(name) isn't read, nor
# Kotlin or Compose (ROADMAP.md).
#
# Needs python3; without it, it fails, never passes.

# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

if [ $# -gt 0 ]; then
    files=()
    for f in "$@"; do
        case $f in *.swift) files+=("$f") ;; esac
    done
else
    files=()
    while IFS= read -r f; do
        [ -f "$f" ] && files+=("$f")
    done < <(motion_files)
fi
if [ ${#files[@]} = 0 ]; then
    echo "check-joins: no Swift files (MOTION_FILES in .practices/config), nothing to check."
    exit 0
fi
if ! command -v python3 >/dev/null; then
    echo "check-joins: needs python3, which isn't installed; the joined lines are unchecked."
    exit 2
fi
python3 "$PRACTICES_BIN/join-audit.py" "${files[@]}"
