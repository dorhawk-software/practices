#!/usr/bin/env bash
# Puts the practices kit into a project, or brings it up to date.
#
#   bin/install PROJECT_DIR              # sync .practices/bin and hooks
#   bin/install --templates PROJECT_DIR  # also copy the starting templates
#
# What it owns in the project (replaced on every run, never edit there):
#   .practices/bin/      the scripts (lint, check-*, claude-hook, ...)
#   .practices/hooks/    git hooks (install-hooks points git at them)
#   .practices/VERSION   which practices commit they came from
#   .practices/docs/     the practices themselves, at this version
#   .practices/rules.md  one line per rule, loaded by CLAUDE.md every session
#   .claude/skills/      the kit's skills (listed in .practices/skills)
# What the project owns (created when missing, never changed after):
#   .practices/config, .github/workflows/practices.yml (pulls updates);
#   and in a Rust project (a Cargo.toml at the root)
#   .practices/coverage-floors, and with --templates clippy.toml,
#   deny.toml, rust-toolchain.toml, .github/dependabot.yml; in any
#   project with --templates, .claude/settings.json (the Claude Code
#   hook). CLAUDE.md is the project's too: install only adds the line
#   that loads .practices/rules.md, once.
# Cargo.toml's lints it can't merge safely: it prints what to paste.
#
# Any project gets the language-neutral part: the privacy check, the
# commit-message check and the git hooks, none of which run cargo. The
# Rust checks (lint, coverage, size, unsafe) run only on Rust files.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)

templates=
if [ "${1:-}" = --templates ]; then
    templates=1
    shift
fi
project=${1:?usage: bin/install [--templates] PROJECT_DIR}
project=$(cd "$project" && git rev-parse --show-toplevel)
version=$(git -C "$here" describe --tags --match 'v[0-9]*.[0-9]*.[0-9]*' --always --dirty)

kit=$project/.practices
rm -rf "${kit:?}/bin" "${kit:?}/hooks"
mkdir -p "$kit/bin" "$kit/hooks"
cp "$here"/scripts/* "$kit/bin/"
cp "$here"/hooks/* "$kit/hooks/"
chmod +x "$kit"/bin/* "$kit"/hooks/*
chmod -x "$kit/bin/lib.sh"
printf '%s\n' "$version" >"$kit/VERSION"
cat >"$kit/README.md" <<EOF
# .practices

The shared practices kit from github.com/dorhawk-software/practices
($version). bin/, hooks/, docs/, rules.md and the skills listed in
skills are synced from there: change them there, not here. config,
coverage-floors, size-allowlist and lint.d/ are this project's own. Once
per clone: \`.practices/bin/install-hooks\`.
EOF

# The practices themselves, pinned to this version, so agents read the
# rules the kit was built for, offline.
rm -rf "${kit:?}/docs"
mkdir -p "$kit/docs"
for dir in common ui rust typescript mobile guides; do
    [ -d "$here/$dir" ] && cp -R "$here/$dir" "$kit/docs/"
done
cp "$here"/README.md "$here"/CHANGELOG.md "$here"/ROADMAP.md "$kit/docs/"

# rules.md: every rule's heading, one line each, grouped by practice. It is
# what CLAUDE.md loads into every session; the detail stays in docs/.
digest() { # digest FILE...: a section per file, a line per "## " heading
    local f title
    for f in "$@"; do
        title=$(sed -n 's/^# //p' "$here/$f" | head -n 1)
        printf '\n## %s (.practices/docs/%s)\n\n' "$title" "$f"
        # headings outside fenced code only (an example's "## Unreleased" isn't a rule)
        awk '/^```/ { fenced = !fenced; next } !fenced && /^## / { sub(/^## /, "- "); print }' "$here/$f" |
            grep -vx -e '- Check' -e '- Apply' || true
    done
}
{
    cat <<EOF
# The practices' rules ($version)

Generated by the practices kit; don't edit it here. Each line is a rule of
this project. Before working in an area, read its file in
.practices/docs/: what the rule is, why (the incident), how to apply it,
how to check it. The project's CLAUDE.md wins where it says otherwise.
The skills in .claude/skills (practices-*) walk through the main jobs.
EOF
    digest common/agent-working-rules.md common/commits.md common/changelog.md \
        common/not-now.md common/testing.md common/claude-md.md \
        common/privacy-public-repos.md common/releases.md common/ci-caching.md \
        common/gates.md common/crash-reports.md
    digest ui/design-before-build.md ui/identity-pass.md ui/visual-craft.md \
        ui/keyboard-shortcuts.md ui/window-buttons.md
    if [ -f "$project/Cargo.toml" ]; then
        digest rust/conventions.md rust/lints.md rust/coverage.md
        if grep -rqs 'gpui' "$project/Cargo.toml"; then digest rust/gpui.md; fi
    fi
    if [ -f "$project/package.json" ]; then
        digest typescript/conventions.md typescript/lints.md typescript/testing.md
    fi
    if [ -d "$project/ios" ] || [ -d "$project/android" ]; then
        digest mobile/releases.md mobile/devices.md mobile/ci.md mobile/lifecycle.md
    fi
} >"$kit/rules.md"

# The skills: the kit's own are listed in .practices/skills, so an update
# replaces exactly those and never a skill the project wrote.
skills=$project/.claude/skills
if [ -f "$kit/skills" ]; then
    while IFS= read -r name; do
        [ -n "$name" ] && rm -rf "${skills:?}/$name"
    done <"$kit/skills"
fi
mkdir -p "$skills"
: >"$kit/skills"
for dir in "$here"/plugin/skills/*/; do
    name=$(basename "$dir")
    [ "$name" = fold-in-a-project ] && continue # works on the practices repo
    if [ -e "$skills/$name" ]; then
        echo "kept:    .claude/skills/$name (the project's own, same name as the kit's)"
        continue
    fi
    cp -R "$dir" "$skills/$name"
    printf '%s\n' "$name" >>"$kit/skills"
done

# CLAUDE.md loads rules.md in every session: add that line once.
load='@.practices/rules.md'
if [ ! -f "$project/CLAUDE.md" ]; then
    printf '# %s\n\n## Practices\n\n%s\n' "$(basename "$project")" "$load" >"$project/CLAUDE.md"
    echo "created: CLAUDE.md (loads .practices/rules.md; add the project's own rules)"
elif ! grep -qxF "$load" "$project/CLAUDE.md"; then
    printf '\n## Practices\n\nThe shared practices, a line per rule:\n%s\n' "$load" >>"$project/CLAUDE.md"
    echo "added:   the line in CLAUDE.md that loads .practices/rules.md"
fi

own() { # copy a template to a project-owned path unless it exists
    if [ -e "$project/$2" ]; then
        echo "kept:    $2 (the project's own)"
    else
        mkdir -p "$(dirname "$project/$2")"
        cp "$here/$1" "$project/$2"
        echo "created: $2"
    fi
}
own templates/config .practices/config
own templates/practices-update.yml .github/workflows/practices.yml
rust=
[ -f "$project/Cargo.toml" ] && rust=1
if [ -n "$rust" ] && [ ! -e "$kit/coverage-floors" ]; then
    printf '# crate folder   linux  macos   (a share of lines, in percent; "-": none)\n' >"$kit/coverage-floors"
    echo "created: .practices/coverage-floors (add each crate's measured share)"
fi

if [ -n "$templates" ]; then
    own templates/claude-settings.json .claude/settings.json
fi
if [ -n "$templates" ] && [ -z "$rust" ]; then
    echo "no Cargo.toml: no Rust templates copied"
fi
if [ -n "$templates" ] && [ -n "$rust" ]; then
    own rust/templates/clippy.toml clippy.toml
    own rust/templates/deny.toml deny.toml
    own rust/templates/rust-toolchain.toml rust-toolchain.toml
    own rust/templates/dependabot.yml .github/dependabot.yml
    if ! grep -q '^\[workspace.lints' "$project/Cargo.toml" 2>/dev/null; then
        echo
        echo "Paste into Cargo.toml (and give each crate \`[lints] workspace = true\`):"
        cat "$here/rust/templates/Cargo-lints.toml"
    fi
fi
echo "practices $version in $project/.practices"
echo
echo "Restart your agent session now (in Claude Code: /exit, then claude again)."
echo "A running session doesn't load the new rules and skills."
